.article-sort-title
  margin: 0 0 12px
  padding: 0 0 18px
  border-bottom: 1px solid rgba(120, 130, 140, .22)
  color: var(--font-color)
  font-size: 1.65em
  font-weight: 600

.article-sort
  margin: 0
  padding: 0

  &-item
    display: flex
    align-items: center
    min-width: 0
    min-height: 82px
    margin: 0
    padding: 16px 8px
    border-bottom: 1px solid rgba(120, 130, 140, .2)
    transition: background-color .2s ease, padding .2s ease

    &:not(.year):hover
      padding-right: 14px
      padding-left: 14px
      background: rgba(73, 177, 245, .08)

    &.year
      min-height: 0
      margin-top: 24px
      padding: 12px 8px 10px
      border-bottom: 2px solid rgba(40, 125, 168, .55)
      color: #287da8
      font-size: 1.45em
      font-weight: 700

      &:first-child
        margin-top: 0

    &-img
      overflow: hidden
      flex: 0 0 auto
      width: 112px
      height: 76px
      addBorderRadius()

      :first-child
        @extend .imgHover

    &-info
      flex: 1
      min-width: 0
      padding: 0 16px

    &.no-article-cover .article-sort-item-info
      display: grid
      grid-template-columns: 132px minmax(0, 1fr)
      align-items: center
      gap: 24px
      padding: 0 8px

    &-time
      color: var(--card-meta)
      font-size: .9em
      white-space: nowrap

      time
        padding-left: 7px
        cursor: default

    &-title
      @extend .limit-more-line
      color: var(--font-color)
      font-size: 1.13em
      font-weight: 500
      line-height: 1.5
      transition: color .2s ease
      -webkit-line-clamp: 2

      &:hover
        color: $text-hover

  +maxWidth768()
    &-item
      min-height: 88px
      padding: 15px 4px

      &.year
        margin-top: 18px
        padding-right: 4px
        padding-left: 4px

      &-img
        width: 86px
        height: 72px

      &-info
        padding: 0 12px

      &.no-article-cover .article-sort-item-info
        grid-template-columns: minmax(0, 1fr)
        gap: 5px
        padding: 0 6px

      &-time
        font-size: .86em

      &-title
        font-size: 1.08em
