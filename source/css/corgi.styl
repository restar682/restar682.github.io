@import 'nib'

// Corgi navigation
#nav
  justify-content: center

  #blog-info
    flex: 1 1 0
    min-width: 0
    padding-left: 24px

    .nav-site-title
      position: relative !important
      // Align with the left edge of the centered two-column content frame.
      left: unquote('calc((100vw - 1300px) / 2 - 55px)')
      display: inline-flex !important
      align-items: center !important
      justify-content: center !important
      box-sizing: border-box !important
      min-width: 44px
      width: auto !important
      height: 44px !important
      padding: 0 10px !important
      line-height: 44px !important
      transition: background-color .2s ease

      &:hover
        border-radius: 7px
        background: #80c6f3

        .site-name
          opacity: 0
          visibility: hidden

        &:after
          position: absolute
          top: 50%
          left: 50%
          color: #fff
          content: '\f015'
          font-weight: 900
          font-size: 24px
          font-family: 'Font Awesome 6 Free'
          transform: translate(-50%, -50%)

    .site-name
      opacity: 1
      visibility: visible
      white-space: nowrap
      transition: opacity .2s ease, visibility .2s ease

  #menus
    flex: 0 0 auto

    > .menus_items
      display: flex
      align-items: center
      gap: 12px
      margin: 0

    .menus_item
      position: relative
      padding: 0

      > .site-page
        display: inline-flex
        align-items: center
        gap: 8px
        min-height: 44px
        padding: 0 4px
        font-size: .84em

        > i:last-child:not(:first-child)
          margin-left: 2px

        &:not(.child):after
          bottom: 6px

      &:hover,
      &:focus-within
        .menus_item_child
          opacity: 1
          visibility: visible
          pointer-events: auto
          transform: translateX(-50%) translateY(0)
          transition-delay: 0s

    .menus_item_child
      position: absolute
      top: 100%
      right: auto
      left: 50%
      z-index: 2
      display: block
      margin: 0
      padding: 6px
      width: max-content
      border: 1px solid rgba(120, 130, 140, .2)
      border-radius: 6px
      background: var(--sidebar-bg)
      box-shadow: 0 8px 24px -8px rgba(0, 0, 0, .45)
      opacity: 0
      visibility: hidden
      pointer-events: none
      transform: translateX(-50%) translateY(4px)
      animation: none
      transition: opacity .16s ease, visibility 0s linear .18s, transform .16s ease

      &:before
        position: absolute
        top: -10px
        left: 0
        width: 100%
        height: 10px
        content: ''

      li
        border-radius: 4px

        a.site-page.child
          display: flex
          align-items: center
          justify-content: flex-start
          gap: 10px
          min-height: 44px
          padding: 0 18px
          text-align: left

  #nav-right
    display: flex
    align-items: center
    justify-content: flex-end
    flex: 1 1 0
    margin: 0

  #search-button
    position: relative
    // Align with the right edge of the centered two-column content frame.
    left: unquote('calc((1300px - 100vw) / 2 + 31px)')
    display: flex
    padding: 0

    .site-page
      display: inline-flex
      align-items: center
      justify-content: center
      width: 44px
      min-height: 44px
      padding: 0

      i
        margin: 0
        font-size: 1em !important
        line-height: 1

      span
        display: none

  #toggle-menu
    padding-left: 8px

    .site-page
      display: inline-flex
      align-items: center
      justify-content: center
      width: 44px
      min-height: 44px
      padding: 0

// The theme centers the visible single-column content at 1016px on desktop.
html.hide-aside #nav #blog-info .nav-site-title
  left: unquote('calc((100vw - 1016px) / 2 - 60px)') !important

html.hide-aside #nav #search-button
  left: unquote('calc((1016px - 100vw) / 2 + 46px)') !important

// Keep the site name only when the navigation becomes fixed.
#page-header.nav-fixed #nav #blog-info .nav-page-title
  display: none !important

@media screen and (max-width: 768px)
  #nav
    #blog-info
      padding-left: 0

    #blog-info .nav-site-title
      left: 0
      padding: 0 6px !important

      &:hover
        background: transparent

        .site-name
          opacity: 1
          visibility: visible

        &:after
          display: none

// Corgi content layout
.layout
  width: 100%
  max-width: 1300px

  > div:first-child
    width: 100%
    box-sizing: border-box

  // Keep the visible content frame consistent across archive, tag and category pages.
  > div:first-child:not(.nc)
    width: 100%
    box-sizing: border-box

  #archive,
  #tag,
  #category
    width: 100%
    box-sizing: border-box

  &.hide-aside
    max-width: 1400px

// Taxonomy pages should use the same visible frame as the two-column layout.
.layout.hide-aside:has(#archive),
.layout.hide-aside:has(#tag),
.layout.hide-aside:has(#category),
.layout.hide-aside:has(.taxonomy-tags),
.layout.hide-aside:has(.taxonomy-categories),
.layout.hide-aside:has(.personal-gallery)
  max-width: 1300px

#post
  width: 78%

.aside-content
  min-width: 300px
  max-width: 312px

// Full-background preview toggle.
body.background-preview
  #page-header
    min-height: 100vh
    background: transparent !important

  #site-info,
  #page-site-info,
  #post-info,
  #scroll-down,
  #content-inner,
  #footer
    display: none !important

// Personal image gallery
.container .flink .flink-list
  display: grid
  grid-template-columns: repeat(2, minmax(0, 1fr))
  gap: 18px
  overflow: visible
  padding: 10px

  > .flink-list-item
    float: none
    margin: 0
    width: auto !important
    height: 150px
    border: 1px solid rgba(120, 130, 140, .16)
    background: var(--card-bg)
    box-shadow: 0 3px 12px rgba(0, 0, 0, .08)

    a
      display: flex
      align-items: center
      height: 100%

      .flink-item-icon
        flex: 0 0 87px
        float: none
        margin: 10px 20px 10px 12px
        width: 87px
        height: 130px

        img
          object-fit: contain

    &:hover .flink-item-icon
      margin: 10px 20px 10px 12px
      width: 87px

    .flink-item-name
      overflow: visible
      padding: 0 18px 0 0
      height: auto
      font-size: 1.65em
      line-height: 1.35
      white-space: normal
      text-align: left

.flink .flink-item-desc:empty
  display: none

@media screen and (max-width: 600px)
  .container .flink .flink-list
    grid-template-columns: minmax(0, 1fr)

.gallery-disclaimer
  display: flex
  align-items: center
  gap: 10px
  margin: 0 0 24px
  padding: 0 0 18px
  border-bottom: 1px solid rgba(120, 130, 140, .22)
  color: var(--card-meta)
  font-size: .92rem

  i
    color: var(--btn-bg)

.personal-gallery
  columns: 5
  column-gap: 12px

  &.is-ready
    display: grid
    grid-template-columns: repeat(9, minmax(0, 1fr))
    grid-auto-flow: dense
    grid-auto-rows: 8px
    gap: 12px
    columns: auto

.personal-gallery-item
  position: relative
  display: block
  overflow: hidden
  break-inside: avoid
  margin: 0 0 12px
  width: 100%
  border-radius: 6px
  background: rgba(120, 130, 140, .1)
  box-shadow: 0 3px 12px rgba(0, 0, 0, .12)

  .personal-gallery.is-ready &
    margin: 0
    grid-column: span 2

    &.is-wide
      grid-column: span 3

  img
    display: block
    width: 100%
    height: auto

@media screen and (max-width: 1024px)
  .personal-gallery
    columns: 3

    &.is-ready
      grid-template-columns: repeat(3, minmax(0, 1fr))

      .personal-gallery-item
        grid-column: span 1

        &.is-wide
          grid-column: span 2

@media screen and (max-width: 768px)
  .personal-gallery
    columns: 2
    column-gap: 8px

  .personal-gallery-item
    margin-bottom: 8px

  .personal-gallery.is-ready
    grid-template-columns: repeat(2, minmax(0, 1fr))

@media screen and (max-width: 768px)
  #recent-posts > .recent-post-item
    height: auto

    > .recent-post-info
      padding: 20px 20px 30px
      width: 100%
      text-align: center
