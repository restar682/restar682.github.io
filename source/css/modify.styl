@import 'nib'

// 顶部图
#page-header
  background: transparent !important
  width: 100% !important
  
  // 滚动后的样式覆盖(针对可能的.fixed或.scroll类)
  &.fixed, &.scroll, &.not-top
    width: 100vw !important // 使用视口宽度
    max-width: 100% !important
    left: 0 !important
    right: 0 !important
  &.post-bg, &.not-home-page
    height: 280px !important
  #post-info
    bottom: 40px !important
    text-align: center
  #page-site-info
    top: 140px !important
  @media screen and (max-width: 768px)
    &.not-home-page
      height: 200px !important
    #post-info
      bottom: 10px !important
    #page-site-info
      top: 100px !important

.top-img
  height: 300px
  margin: -50px -40px 50px
  border-top-left-radius: inherit
  border-top-right-radius: inherit
  background-position: center
  background-size: cover
  transition: all .3s

  @media screen and (max-width: 768px)
    height: 230px
    margin: -36px -14px 36px

  [data-theme='dark'] &
    filter: brightness(.8)

// 页脚
#footer:before
  background-color: alpha(#FFF, .5)

  [data-theme='dark'] &
    background-color: alpha(#000, .5)

#footer-wrap, #footer-wrap a
  color: #111
  transition: unset

  [data-theme='dark'] &
    color: var(--light-grey)

// Sidebar cards collapse to their title row.
#aside-content .card-widget.aside-collapsible
  > .item-headline
    display: flex
    align-items: center
    margin: -6px -8px
    padding: 6px 8px
    line-height: 24px
    user-select: none

    .aside-collapse-button
      display: inline-flex
      flex: 0 0 28px
      align-items: center
      justify-content: center
      margin-left: auto
      width: 28px
      height: 28px
      border-radius: 4px
      color: var(--font-color)
      transition: background-color .2s ease, color .2s ease

      &:hover,
      &:focus-visible
        outline: none
        background: var(--text-bg-hover)
        color: var(--text-highlight-color)

    .aside-collapse-icon
      font-size: .8em
      transition: transform .2s ease

  &.is-collapsed
    padding: 10px 14px

    > .item-headline
      padding-bottom: 6px

      .aside-collapse-icon
        transform: rotate(-90deg)

    > :not(.item-headline)
      display: none !important

  &:not(.is-collapsed)
    > .item-headline + *
      margin-top: 10px

#aside-content
  #card-toc > .toc-content,
  .card-post-series > .aside-list,
  .card-recent-post > .aside-list,
  .card-tags > .card-tag-cloud,
  .card-categories > .card-category-list,
  .card-archives > .card-archive-list
    overflow-y: auto
    overscroll-behavior: contain
    max-height: unquote('min(52vh, 520px)')
    padding-right: 4px
    scrollbar-gutter: stable

    &::-webkit-scrollbar-thumb
      border-radius: 999px
